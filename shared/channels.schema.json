{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viktorjonsson77.github.io/radioapp/channels.schema.json",
  "title": "RadioApp channel catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channels"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "srChannelId", "name", "shortName", "description", "streamUrl", "streamQuality", "streamFormat", "imageUrl", "category", "region", "isLocal", "isFavoriteCapable"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "srChannelId": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "streamUrl": { "type": "string", "pattern": "^https://live1\\.sr\\.se/[a-z0-9-]+$" },
        "streamQuality": { "enum": ["AAC_128"] },
        "streamFormat": { "enum": ["AAC"] },
        "imageUrl": { "type": "string", "pattern": "^https://" },
        "category": { "enum": ["NATIONAL", "LOCAL_P4", "NEWS", "MUSIC", "DIGITAL", "LANGUAGE", "CHILDREN"] },
        "region": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] },
        "isLocal": { "type": "boolean" },
        "isFavoriteCapable": { "type": "boolean" }
      }
    }
  }
}
